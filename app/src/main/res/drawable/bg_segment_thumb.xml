<?xml version="1.0" encoding="utf-8"?>
<!--
  Segmented control THUMB: the capsule that marks the active tab.

  True capsule (see @dimen/radius_capsule), flat active fill, no stroke and no shadow.
  It reads as raised purely from the tint step against the recessed track behind it,
  which is all it needs now that the panel has a real backdrop blur.

  Anything drawn on this fill must use @style/TextOnGlassActive or applyGlassInk(true):
  the fill is near-opaque ink of the same hue as the labels, so text left at
  primaryColor is invisible. See values/surfaces.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/glassActive" />
    <corners android:radius="@dimen/radius_capsule" />
</shape>
