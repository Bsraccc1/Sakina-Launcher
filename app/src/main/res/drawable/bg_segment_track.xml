<?xml version="1.0" encoding="utf-8"?>
<!--
  Segmented control TRACK: a frosted capsule well.

  Capsule, not a rounded rectangle: @dimen/radius_capsule is far larger than half the
  track's height, so the shape resolves to a true capsule at any height. The original
  14dp radius was smaller than half the height, which is why the pill looked like a box.

  Depth is one step of tint darker than the surface it sits on, plus a hairline. The
  earlier five-layer version (wall / shade falloff / floor gradient / front lip) is gone:
  it read as a border rather than a shadow, and with the window blur active it is not
  needed.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/glassSunken" />
    <corners android:radius="@dimen/radius_capsule" />
    <stroke
        android:width="1dp"
        android:color="?attr/glassHairline" />
</shape>
