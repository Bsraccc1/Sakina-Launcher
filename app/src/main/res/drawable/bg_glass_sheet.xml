<?xml version="1.0" encoding="utf-8"?>
<!-- Glass sheet: dialog/sheet surface. Opaque enough to read, still not a slab. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dialogSurfaceSolid" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/glassHairline" />
</shape>
