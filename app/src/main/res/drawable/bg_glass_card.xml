<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card: raised surface + hairline. No gradient, no shadow, no emboss. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/glassRaised" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/glassHairline" />
</shape>
