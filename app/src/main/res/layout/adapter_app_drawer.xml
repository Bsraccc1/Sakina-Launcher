<?xml version="1.0" encoding="utf-8"?><!--
  One app-drawer row. Steady state is 3 views: the label, the work/private-profile dot
  and the ViewStubs. The long-press menu and the rename row live in separate layouts
  behind ViewStubs (@+id/appHideStub, @+id/renameStub) so a row the user only scrolls
  past never constructs them — that removed 10 of 13 views per row.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/appTitle"
        style="@style/TextLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="24dp"
        android:paddingVertical="7dp"
        android:text="@string/app"
        android:textSize="21sp" />

    <ImageView
        android:id="@+id/otherProfileIndicator"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:src="@drawable/ic_rounded"
        app:tint="?attr/primaryColor" />

    <ViewStub
        android:id="@+id/appHideStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="1dp"
        android:inflatedId="@+id/appHideLayout"
        android:layout="@layout/adapter_app_drawer_menu" />

    <ViewStub
        android:id="@+id/renameStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/renameLayout"
        android:layout="@layout/adapter_app_drawer_rename" />

</FrameLayout>
