<?xml version="1.0" encoding="utf-8"?>
<!--
  Muslim Center — symmetric glass layout.

  Geometry rules (keep them if you edit this file):
   * One 20dp page gutter, one 14dp gap between cards, one 20dp card padding.
   * The five prayer chips live in ONE row with equal weight, so the grid is
     symmetric by construction (the old 3+2 layout needed an invisible spacer).
   * The three dhikr cards likewise share one row with equal weight.
   * Surfaces come from the glass token system only: bg_glass_card /
     bg_glass_inset / bg_glass_active. No elevation, no gradient, no emboss.
-->
<app.sakinalauncher.ui.view.SwipeAwareScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_scrim"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="28dp">

        <!--
          Header: explicit back affordance on the left, title on the true centre.
          The right spacer is the same width as the button so the title stays
          optically centred instead of being pushed off-axis.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:contentDescription="@string/nav_back"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                android:id="@+id/title"
                style="@style/TextLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="@string/muslim_center"
                android:textSize="24sp" />

            <View
                android:layout_width="42dp"
                android:layout_height="42dp" />

        </LinearLayout>

        <!-- ============================ PRAYER CARD ============================ -->
        <LinearLayout
            android:id="@+id/prayerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="@string/prayer_times"
                android:textAllCaps="true"
                android:textSize="10sp" />

            <!-- Hero: which prayer is next, at what time, how long from now -->
            <LinearLayout
                android:id="@+id/nextPrayerHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nextPrayerName"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:textSize="18sp"
                    tools:text="Maghrib" />

                <TextView
                    android:id="@+id/nextPrayer"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-thin"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    android:textSize="54sp"
                    tools:text="18:08" />

                <TextView
                    android:id="@+id/nextPrayerCountdown"
                    style="@style/TextSmallLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:maxLines="1"
                    android:text="@string/next_prayer"
                    android:textAllCaps="true"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Five prayers, one symmetric row -->
            <LinearLayout
                android:id="@+id/prayerChipRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/subuhTime"
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_inset"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    tools:text="Subuh\n04:39" />

                <TextView
                    android:id="@+id/dzuhurTime"
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_inset"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    tools:text="Dzuhur\n11:56" />

                <TextView
                    android:id="@+id/asharTime"
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_inset"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    tools:text="Ashar\n15:17" />

                <TextView
                    android:id="@+id/maghribTime"
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_inset"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    tools:text="Maghrib\n17:49" />

                <TextView
                    android:id="@+id/isyaTime"
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_inset"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    tools:text="Isya\n19:02" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="?attr/glassHairline" />

            <!-- Location is the primary action of this card: tap to change -->
            <TextView
                android:id="@+id/location"
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:alpha="0.78"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/set_location_placeholder"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/prayerSource"
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="2"
                android:alpha="0.75"
                android:textSize="12sp"
                tools:text="Calculated offline - MWL" />

        </LinearLayout>

        <!-- ============================ DHIKR ROW ============================ -->
        <LinearLayout
            android:id="@+id/dhikrRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/morningDhikrCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="132dp"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="18dp">

                <TextView
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/muslim_dhikr_icon_slot"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/dzikir_pagi_icon"
                    android:textSize="26sp" />

                <TextView
                    style="@style/TextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/dzikir_pagi"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/morningDhikr"
                    style="@style/TextSmallLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/eveningDhikrCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="132dp"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="18dp">

                <TextView
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/muslim_dhikr_icon_slot"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/dzikir_petang_icon"
                    android:textSize="26sp" />

                <TextView
                    style="@style/TextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/dzikir_petang"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/eveningDhikr"
                    style="@style/TextSmallLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/afterPrayerDhikrCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="132dp"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="18dp">

                <TextView
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/muslim_dhikr_icon_slot"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/muslim_after_prayer_icon"
                    android:textSize="26sp" />

                <TextView
                    style="@style/TextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/muslim_after_prayer_title"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/afterPrayerDhikr"
                    style="@style/TextSmallLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/source"
            style="@style/TextSmallLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.8"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/dzikir_source"
            android:textSize="12sp" />

    </LinearLayout>

</app.sakinalauncher.ui.view.SwipeAwareScrollView>
